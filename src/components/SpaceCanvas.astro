---
/**
 * 全ページ共通の星空背景。
 * 固定キャンバスに Three.js(WebGPU) の星空を描画し、背後に
 * 深宇宙のグラデーション（WebGL 不可環境でも成立する保険）を敷く。
 */
---

<div class="space-bg" aria-hidden="true">
  <canvas id="space-canvas"></canvas>
</div>

<style>
  .space-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    /* 深宇宙のグラデーション（キャンバス透過の背後に常に存在） */
    background:
      radial-gradient(1200px 800px at 75% 18%, rgba(91, 63, 140, 0.35), transparent 60%),
      radial-gradient(1000px 900px at 18% 80%, rgba(39, 70, 144, 0.4), transparent 60%),
      linear-gradient(180deg, #05060f 0%, #0a0e23 45%, #0f1d3e 100%);
    pointer-events: none;
  }

  #space-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  import { SpaceBackground } from '@lib/space/SpaceBackground';
  import { setSpaceInstance } from '@lib/space/instance';

  const debug = new URLSearchParams(location.search).has('debug');
  const badge = (msg: string) => {
    if (!debug) return;
    let el = document.getElementById('space-status');
    if (!el) {
      el = document.createElement('div');
      el.id = 'space-status';
      el.style.cssText =
        'position:fixed;left:8px;bottom:8px;z-index:99999;font:12px monospace;color:#fff2ad;background:rgba(0,0,0,.6);padding:4px 8px;border-radius:4px;';
      document.body.appendChild(el);
    }
    el.textContent = msg;
  };

  const canvas = document.getElementById('space-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const space = new SpaceBackground(canvas);
    badge('space: init…');
    space
      .init()
      .then(() => {
        setSpaceInstance(space);
        badge('space: ready (' + space.backendName() + ')');
      })
      .catch((err) => {
        // WebGPU/WebGL いずれも使えない場合は CSS グラデーション背景にフォールバック
        console.warn('[space] 3D 背景を初期化できませんでした:', err);
        canvas.style.display = 'none';
        badge('space: FAILED ' + (err?.message ?? err));
      });
  }
</script>
