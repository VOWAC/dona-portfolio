---
/**
 * 星空テーマのローディング画面。
 * 深宇宙のグラデーション上で星座がきらめき、準備完了でフェードアウトする。
 * - window load / 星空背景の準備完了 / 6秒の安全タイマー のいずれかで解除
 * - prefers-reduced-motion ではアニメーションを抑制
 */
---

<div class="loading-overlay" id="loading-screen">
  <div class="constellation">
    <span class="orbit"></span>
    <span class="star star-main"></span>
    <span class="star star-a"></span>
    <span class="star star-b"></span>
    <span class="star star-c"></span>
  </div>
  <p class="loading-word">DONA's Portfolio</p>
  <p class="loading-sub">星空を準備しています…</p>
</div>

<style>
  .loading-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2.2rem;
    text-align: center;
    color: #fff2ad;
    background:
      radial-gradient(900px 700px at 70% 22%, rgba(91, 63, 140, 0.4), transparent 60%),
      radial-gradient(800px 800px at 22% 78%, rgba(39, 70, 144, 0.45), transparent 60%),
      linear-gradient(180deg, #05060f 0%, #0a0e23 45%, #0f1d3e 100%);
    transition:
      opacity 0.9s ease-out,
      visibility 0.9s ease-out;
  }

  .loading-overlay.hide {
    opacity: 0;
    visibility: hidden;
  }

  .constellation {
    position: relative;
    width: 120px;
    height: 120px;
  }

  .orbit {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(223, 232, 255, 0.25);
    border-radius: 50%;
    animation: orbit-spin 6s linear infinite;
  }
  .orbit::after {
    content: "";
    position: absolute;
    top: -3px;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #dfe8ff;
    box-shadow: 0 0 10px 3px rgba(155, 184, 255, 0.8);
    transform: translateX(-50%);
  }

  .star {
    position: absolute;
    background-color: #fff2ad;
    clip-path: polygon(
      50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%,
      50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%
    );
    filter: drop-shadow(0 0 6px rgba(255, 242, 173, 0.8));
  }

  .star-main {
    width: 46px;
    height: 46px;
    top: 37px;
    left: 37px;
    animation: twinkle 2.4s ease-in-out infinite;
  }
  .star-a {
    width: 14px;
    height: 14px;
    top: 6px;
    left: 84px;
    animation: twinkle 1.8s ease-in-out infinite 0.3s;
  }
  .star-b {
    width: 10px;
    height: 10px;
    top: 92px;
    left: 14px;
    animation: twinkle 2.1s ease-in-out infinite 0.7s;
  }
  .star-c {
    width: 8px;
    height: 8px;
    top: 80px;
    left: 96px;
    animation: twinkle 1.6s ease-in-out infinite 1s;
  }

  .loading-word {
    font-size: 1.5rem;
    letter-spacing: 0.3rem;
    color: #fff;
    opacity: 0.95;
  }
  .loading-sub {
    font-size: 0.85rem;
    letter-spacing: 0.2rem;
    color: rgba(223, 232, 255, 0.7);
    animation: breathe 2.4s ease-in-out infinite;
  }

  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes twinkle {
    0%, 100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
    50% {
      opacity: 0.55;
      transform: scale(0.85) rotate(8deg);
    }
  }
  @keyframes breathe {
    0%, 100% {
      opacity: 0.4;
    }
    50% {
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit,
    .star,
    .loading-sub {
      animation: none;
    }
  }
</style>

<script>
  import { onSpaceReady } from "@lib/space/instance";

  const screen = document.getElementById("loading-screen");
  let hidden = false;
  const hide = () => {
    if (hidden) return;
    hidden = true;
    screen?.classList.add("hide");
  };

  // 準備完了の合図（いずれか早いもの）でフェードアウト
  if (document.readyState === "complete") {
    setTimeout(hide, 400);
  } else {
    window.addEventListener("load", () => setTimeout(hide, 400));
  }
  // 星空背景が描画開始したら隠す（トップページ）
  onSpaceReady(() => setTimeout(hide, 300));
  // 念のための安全タイマー（何かが詰まっても必ず解除）
  setTimeout(hide, 6000);
</script>
