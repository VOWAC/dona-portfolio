---
/**
 * 星型カスタムカーソル（芯 + 遅延リング）。
 * 実体は cursor.ts が生成。ここではスタイルと初期化のみ。
 */
---

<style is:global>
  /* マウス主体の環境のみネイティブカーソルを隠す */
  @media (pointer: fine) {
    body.has-custom-cursor,
    body.has-custom-cursor a,
    body.has-custom-cursor button,
    body.has-custom-cursor .interactive {
      cursor: none;
    }
  }

  .cursor-core,
  .cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 10000;
    will-change: transform;
    mix-blend-mode: screen;
  }

  /* 芯：きらめく小さな光点 */
  .cursor-core {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffffff 0%, #fff2ad 55%, rgba(255, 242, 173, 0) 100%);
    box-shadow:
      0 0 8px 2px rgba(255, 242, 173, 0.9),
      0 0 18px 6px rgba(185, 160, 203, 0.5);
  }

  /* リング：ゆったり追従、ホバーで拡大 */
  .cursor-ring {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(223, 232, 255, 0.7);
    box-shadow:
      0 0 12px rgba(155, 184, 255, 0.4),
      inset 0 0 10px rgba(155, 184, 255, 0.2);
    transition:
      width 0.3s ease,
      height 0.3s ease,
      border-color 0.3s ease,
      opacity 0.3s ease;
  }

  .cursor-ring.is-hover {
    width: 64px;
    height: 64px;
    border-color: rgba(255, 242, 173, 0.9);
  }

  .cursor-ring.is-down {
    width: 26px;
    height: 26px;
  }
</style>

<script>
  import { initCursor } from '@lib/cursor/cursor';
  initCursor();
</script>
