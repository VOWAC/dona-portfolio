---
import Footer from "@components/Footer.astro";
import Loading from "@components/Loading.astro";
import SpaceCanvas from "@components/SpaceCanvas.astro";
import CustomCursor from "@components/CustomCursor.astro";
import "@styles/global.css";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<!-- リセットcss -->
		<link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/destyle.css@1.0.15/destyle.css"
    />
    <!-- googleフォント -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@200&family=Sawarabi+Mincho&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>DONA's portfolio</title>
  </head>
  <body>
    <SpaceCanvas />
    <CustomCursor />
    <Loading />
    <slot />
		<Footer />
  </body>
</html>

<script>
  import { initSmoothScroll } from "@lib/scroll/smoothScroll";
  import { initPointerParallax } from "@lib/parallax/pointerParallax";
  initSmoothScroll();
  initPointerParallax();
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: "Sawarabi Mincho", serif;
    background: transparent;
  }
  body {
    /* 星空の上に載る内部ページの基本文字色（明色） */
    color: #dfe8ff;
  }
</style>
